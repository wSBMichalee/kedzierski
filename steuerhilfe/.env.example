# ───────────────────────────────────────────────────────────────
# Lohnsteuerhilfe — .env.example
# Skopiuj do .env.local i uzupełnij wartości.
# NIGDY nie commituj .env.local do repo!
# ───────────────────────────────────────────────────────────────

# ── Payload CMS ──────────────────────────────────────────────
# WYMAGANE w RUNTIME (nie tylko build). Bez niego /admin pada.
PAYLOAD_SECRET=twoj-tajny-klucz-minimum-32-znaki

# ── Baza danych ──────────────────────────────────────────────
# Postgres — obowiązkowy na produkcji (NIE SQLite plik w Dockerze)
DATABASE_URL=postgresql://user:password@localhost:5432/steuerhilfe

# ── Next.js / SEO ────────────────────────────────────────────
# WYMAGANE w BUILD (NEXT_PUBLIC_* wstrzykiwane przy budowaniu)
# Potrzebne dla canonical URL, sitemap, hreflang
NEXT_PUBLIC_SERVER_URL=https://twoja-domena.de

# ── Mapbox ───────────────────────────────────────────────────
# Publiczny token (tylko do odczytu map)
# Utwórz na: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiTkFaV0EiLCJhIjoiTkFaV0EifQ.PLACEHOLDER

# ── Cloudflare Turnstile (opcjonalne — formularze) ───────────
# Site key (publiczny) — wyświetlany w formularzu
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key (prywatny) — TYLKO na serwerze, nie NEXT_PUBLIC_!
# Konfigurowany w panelu Payload (SiteIntegrations)
# TURNSTILE_SECRET_KEY=  ← ustaw w Coolify / Docker, nie tutaj

# ── Email (SMTP) ─────────────────────────────────────────────
# Konfigurowany w panelu Payload (SiteIntegrations → SMTP)
# Dzięki panelSmtpAdapter() nie potrzebujesz tu zmiennych SMTP
# Ale jeśli wolisz statyczną konfigurację:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@twoja-domena.de
# SMTP_PASS=

# ── Plausible Analytics (opcjonalne) ─────────────────────────
# RODO-friendly alternatywa dla GA4
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=twoja-domena.de
